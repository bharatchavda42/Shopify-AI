{{ 'wellness.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wellness.js' | asset_url }}" defer="defer"></script>

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    {%- if section.settings.heading != blank -%}
      <div class="wc-section__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="wc-heading wc-heading--lg">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div data-wc-testimonial data-wc-autoplay="{{ section.settings.autoplay }}">
      {%- for block in section.blocks -%}
        <article class="wc-testimonial" data-wc-slide {% if forloop.first == false %}hidden{% endif %} {{ block.shopify_attributes }}>
          <span class="wc-testimonial__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- assign rating = block.settings.rating | default: 5 | at_most: 5 | at_least: 0 -%}
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" fill="{% if i <= rating %}currentColor{% else %}rgba(255,255,255,.25){% endif %}" aria-hidden="true">
                <path d="M10 1.6l2.6 5.3 5.8.9-4.2 4.1 1 5.8L10 15l-5.2 2.7 1-5.8L1.6 7.8l5.8-.9z"/>
              </svg>
            {%- endfor -%}
          </span>
          <blockquote class="wc-testimonial__quote">"{{ block.settings.quote | escape }}"</blockquote>
          <div class="wc-testimonial__meta">
            {%- if block.settings.avatar != blank -%}
              <span class="wc-testimonial__avatar">
                <img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.author | escape }}" loading="lazy" decoding="async" width="56" height="56">
              </span>
            {%- endif -%}
            <span>
              <div class="wc-testimonial__name">{{ block.settings.author | escape }}</div>
              {%- if block.settings.role != blank -%}
                <div class="wc-testimonial__role">{{ block.settings.role | escape }}</div>
              {%- endif -%}
            </span>
          </div>
        </article>
      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}
        <div class="wc-testimonial__nav" role="tablist" aria-label="Testimonials">
          {%- for block in section.blocks -%}
            <button type="button" class="wc-testimonial__dot" data-wc-dot aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show testimonial {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness testimonials",
  "tag": "section",
  "class": "shopify-section--wellness-testimonials",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Patient stories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Patients Are Saying" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slides", "default": true },
    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The clinic provided structured, physician-led support that finally helped me reach my goals safely." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "author", "label": "Author", "default": "Sarah J." },
        { "type": "text", "id": "role", "label": "Role/Location", "default": "Charlotte, NC" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "author": "Michael R.", "quote": "Lab-monitored, personalized care made a real difference. The team was attentive every step of the way." } },
        { "type": "testimonial", "settings": { "author": "Aisha P.", "quote": "I appreciated the transparency on pricing and the physician oversight from day one." } }
      ]
    }
  ]
}
{% endschema %}

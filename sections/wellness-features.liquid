{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.subheading != blank
    -%}
      <div class="wc-section__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wc-heading wc-heading--lg">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="wc-text wc-text--lead">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="wc-grid {% if section.blocks.size == 4 %}wc-grid--4{% elsif section.blocks.size == 2 %}wc-grid--2{% else %}wc-grid--3{% endif %}">
      {%- for block in section.blocks -%}
        <article
          class="wc-card {% if block.settings.style == 'mint' %}wc-card--mint{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span class="wc-card__icon">
            {%- case block.settings.icon -%}
              {%- when 'stethoscope' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M9 6v10a5 5 0 0010 0V6"/><circle cx="22" cy="22" r="3"/><path d="M22 19v-5"/>
                </svg>
              {%- when 'clipboard' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="8" y="7" width="16" height="20" rx="2"/><path d="M12 5h8v4h-8z"/><path d="M12 14h8M12 18h8M12 22h5"/>
                </svg>
              {%- when 'lab' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M13 4v8L7 24a3 3 0 003 4h12a3 3 0 003-4l-6-12V4"/><path d="M11 4h10"/>
                </svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M16 4l10 4v8c0 7-5 11-10 12-5-1-10-5-10-12V8z"/><path d="M12 16l3 3 6-6"/>
                </svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M16 27s-9-5-9-13a5 5 0 019-3 5 5 0 019 3c0 8-9 13-9 13z"/>
                </svg>
              {%- when 'check' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M7 16l6 6 12-12" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M6 8h20v14H14l-6 5v-5H6z"/>
                </svg>
              {%- when 'calendar' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="6" y="8" width="20" height="18" rx="2"/><path d="M6 14h20M11 5v6M21 5v6"/>
                </svg>
              {%- when 'doctor' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="16" cy="10" r="4"/><path d="M8 26v-2c0-4 4-6 8-6s8 2 8 6v2"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="16" cy="16" r="10"/><path d="M12 16l3 3 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            {%- endcase -%}
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="wc-card__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="wc-card__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div style="text-align:center; margin-top:36px;">
        <a href="{{ section.settings.button_link | default: '#' }}" class="wc-btn wc-btn--primary">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wellness features",
  "tag": "section",
  "class": "shopify-section--wellness-features",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Our Medical Weight Loss Is Different" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Built around your medical history, physician guidance, and outcomes.</p>"
    },
    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "alt",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Optional CTA" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "stethoscope",
          "options": [
            { "value": "stethoscope", "label": "Stethoscope" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "lab", "label": "Lab" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" },
            { "value": "chat", "label": "Chat" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "doctor", "label": "Doctor" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Physician-led care" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>All treatment plans are directed and monitored by a board-certified physician.</p>"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Card style",
          "default": "default",
          "options": [
            { "value": "default", "label": "White" },
            { "value": "mint", "label": "Mint" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness features",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "stethoscope",
            "title": "Physician-led care",
            "text": "<p>Plans are directed by a board-certified internal medicine physician.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "lab",
            "title": "Lab monitoring",
            "text": "<p>Routine lab panels track safety and progress throughout your program.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "shield",
            "title": "FDA-approved options",
            "text": "<p>Access to evidence-based medications including semaglutide and tirzepatide.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-pricing">
      <div class="wc-pricing__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wc-heading wc-heading--md">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="wc-text">{{ section.settings.intro }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:8px;">
            <a href="{{ section.settings.button_link | default: '#' }}" class="wc-btn wc-btn--primary">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="wc-pricing__notes" style="margin-top:24px;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'note' -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <aside class="wc-pricing__card" aria-label="{{ section.settings.card_label | escape }}">
        {%- if section.settings.card_label != blank -%}
          <span class="wc-pricing__card-label">{{ section.settings.card_label | escape }}</span>
        {%- endif -%}
        {%- if section.settings.card_price != blank -%}
          <span class="wc-pricing__price">{{ section.settings.card_price | escape }}</span>
        {%- endif -%}
        {%- if section.settings.card_subtitle != blank -%}
          <span class="wc-pricing__sub">{{ section.settings.card_subtitle | escape }}</span>
        {%- endif -%}
        {%- if section.settings.card_footnote != blank -%}
          <p class="wc-pricing__sub" style="margin:0;">{{ section.settings.card_footnote }}</p>
        {%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness pricing",
  "tag": "section",
  "class": "shopify-section--wellness-pricing",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Program Cost & What's Included" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Transparent pricing with physician-guided care, structured monitoring, and a clear treatment plan.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View Our Pricing" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Highlight card" },
    { "type": "text", "id": "card_label", "label": "Card label", "default": "Initial Consultation (Virtual or In-Person)" },
    { "type": "text", "id": "card_price", "label": "Price", "default": "$149" },
    { "type": "text", "id": "card_subtitle", "label": "Subtitle", "default": "consultation only" },
    { "type": "richtext", "id": "card_footnote", "label": "Footnote", "default": "<p>Lab testing and medications are not included and are billed separately.</p>" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Note text", "default": "We accept HSA/FSA payments." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness pricing",
      "blocks": [
        { "type": "note", "settings": { "text": "We accept HSA/FSA payments. Financing options such as CareCredit may be available." } },
        { "type": "note", "settings": { "text": "Lab testing may be covered by insurance depending on your plan. Coverage varies and is not guaranteed." } },
        { "type": "note", "settings": { "text": "We assist with prior authorization for medications when appropriate, approval depends on each insurer's clinical criteria." } },
        { "type": "note", "settings": { "text": "Most patients start treatment within 1–2 visits." } }
      ]
    }
  ]
}
{% endschema %}

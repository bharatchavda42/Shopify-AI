{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wc-heading wc-heading--lg">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="wc-text wc-text--lead">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="wc-grid wc-grid--3">
      {%- if section.settings.blog != blank -%}
        {%- assign blog = blogs[section.settings.blog] -%}
        {%- assign limit = section.settings.posts_to_show | default: 3 -%}
        {%- for article in blog.articles limit: limit -%}
          <article class="wc-insight-card">
            <div class="wc-insight-card__media">
              {%- if article.image != blank -%}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
              {%- endif -%}
            </div>
            <div class="wc-insight-card__body">
              {%- if section.settings.show_date -%}
                <span class="wc-insight-card__meta">{{ article.published_at | date: '%b %d, %Y' }}</span>
              {%- endif -%}
              <h3 class="wc-insight-card__title">
                <a href="{{ article.url }}" style="color:inherit; text-decoration:none;">{{ article.title | escape }}</a>
              </h3>
              {%- if section.settings.show_excerpt and article.excerpt_or_content != blank -%}
                <p class="wc-insight-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="wc-insight-card__link">Read article →</a>
            </div>
          </article>
        {%- else -%}
          <p class="wc-text">No articles found.</p>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <article class="wc-insight-card" {{ block.shopify_attributes }}>
            <div class="wc-insight-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- endif -%}
            </div>
            <div class="wc-insight-card__body">
              {%- if block.settings.tag != blank -%}
                <span class="wc-insight-card__meta">{{ block.settings.tag | escape }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="wc-insight-card__title">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" style="color:inherit; text-decoration:none;">{{ block.settings.title | escape }}</a>
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </h3>
              {%- endif -%}
              {%- if block.settings.excerpt != blank -%}
                <p class="wc-insight-card__excerpt">{{ block.settings.excerpt | escape }}</p>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="wc-insight-card__link">Read article →</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness insights",
  "tag": "section",
  "class": "shopify-section--wellness-insights",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Physician Insights" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Charlotte Wellness team" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Articles and education from our medical staff.</p>" },
    { "type": "header", "content": "Blog source" },
    { "type": "blog", "id": "blog", "label": "Pick a blog", "info": "Leave empty to use static cards from blocks." },
    { "type": "range", "id": "posts_to_show", "label": "Posts to show", "min": 1, "max": 9, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Static article",
      "limit": 9,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Article" },
        { "type": "text", "id": "title", "label": "Title", "default": "Understanding GLP-1 medications" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "What patients should know about semaglutide and tirzepatide." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness insights",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "title": "How lab monitoring protects you" } },
        { "type": "card", "settings": { "title": "Setting realistic weight loss goals" } }
      ]
    }
  ]
}
{% endschema %}

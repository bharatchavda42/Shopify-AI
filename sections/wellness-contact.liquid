{%- liquid
  assign s = section.settings
  assign eyebrow = s.eyebrow | strip
  assign heading = s.heading | strip
  assign description = s.description
  assign form_heading = s.form_heading | strip
  assign submit_label = s.submit_label | default: 'Submit'
  assign program_label = s.program_label | default: 'Which program are you interested in?'
  assign program_ph = s.program_placeholder | default: 'Select a program'
  assign success_msg = s.success_message | default: "Thanks! We'll be in touch shortly."

  assign program_options = s.program_options | newline_to_br | split: '<br />'
  assign accent = s.accent_color
  assign show_form = s.show_form

  assign contact_form_id = 'WellnessContactForm-' | append: section.id
-%}

{% style %}
  #shopify-section-{{ section.id }}{
    --wc-bg: {{ s.section_bg | default: '#ffffff' }};
    --wc-banner-from: {{ s.banner_bg | default: '#E8F4F4' }};
    --wc-eyebrow: {{ s.eyebrow_color | default: '#2F6F73' }};
    --wc-heading: {{ s.heading_color | default: '#2F6F73' }};
    --wc-body: {{ s.body_color | default: '#2A2A2A' }};
    --wc-card-bg: {{ s.card_bg | default: '#ffffff' }};
    --wc-card-border: {{ s.card_border | default: '#B3B3B3' }};
    --wc-card-label: {{ s.label_color | default: '#3B4344' }};
    --wc-form-bg: {{ s.form_bg | default: '#F5F5F5' }};
    --wc-form-border: {{ s.form_border | default: '#E5EAEE' }};
    --wc-input-bg: {{ s.input_bg | default: '#ffffff' }};
    --wc-input-placeholder: {{ s.placeholder_color | default: '#8F8F8F' }};
    --wc-accent: {{ accent | default: '#2F6F73' }};
    --wc-accent-contrast: {{ s.accent_text_color | default: '#ffffff' }};
    --wc-max-w: {{ s.container_width | default: 1200 }}px;
    --wc-pt: {{ s.padding_top | default: 0 }}px;
    --wc-pb: {{ s.padding_bottom | default: 96 }}px;
    --wc-banner-pt: {{ s.banner_padding_top | default: 90 }}px;
    --wc-banner-pb: {{ s.banner_padding_bottom | default: 40 }}px;
    --wc-radius: {{ s.corner_radius | default: 24 }}px;
    --wc-card-radius: {{ s.card_radius | default: 12 }}px;
  }
{% endstyle %}

<section
  class="wellness-contact color-{{ s.color_scheme }} gradient"
  aria-label="{{ heading | default: 'Contact' | escape }}"
>
  {%- if s.show_banner and eyebrow != blank or heading != blank or description != blank -%}
    <div class="wellness-contact__banner">
      <div class="wellness-contact__container wellness-contact__banner-inner">
        {%- if eyebrow != blank -%}
          <p class="wellness-contact__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="wellness-contact__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if description != blank -%}
          <div class="wellness-contact__description rte">{{ description }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="wellness-contact__container wellness-contact__body">
    {%- if section.blocks.size > 0 -%}
      <ul class="wellness-contact__cards" role="list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'info_card' -%}
              <li class="wellness-contact__card" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="wellness-contact__card-icon" aria-hidden="true">
                    {{
                      block.settings.icon
                      | image_url: width: 48
                      | image_tag: loading: 'lazy', widths: '24, 48, 72', sizes: '24px', width: 24, height: 24, alt: ''
                    }}
                  </span>
                {%- endif -%}
                <div class="wellness-contact__card-text">
                  {%- if block.settings.title != blank -%}
                    <p class="wellness-contact__card-title">{{ block.settings.title }}</p>
                  {%- endif -%}
                  {%- if block.settings.lines != blank -%}
                    <div class="wellness-contact__card-lines">{{ block.settings.lines | newline_to_br }}</div>
                  {%- endif -%}
                </div>
              </li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="wellness-contact__split">
      {%- comment -%} ---------- MAP / IMAGE ---------- {%- endcomment -%}
      <div class="wellness-contact__media">
        {%- if s.map_embed_url != blank -%}
          <div class="wellness-contact__map">
            <iframe
              src="{{ s.map_embed_url }}"
              title="{{ s.map_title | default: 'Clinic location map' | escape }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        {%- elsif s.map_image != blank -%}
          {%- if s.map_link != blank -%}
            <a href="{{ s.map_link }}" class="wellness-contact__map-link" target="_blank" rel="noopener">
          {%- endif -%}
          <div class="wellness-contact__map">
            {{
              s.map_image
              | image_url: width: 1020
              | image_tag:
                loading: 'lazy',
                widths: '320, 510, 720, 1020, 1530',
                sizes: '(min-width: 990px) 510px, 100vw',
                alt: s.map_image.alt
              | default: s.map_title
            }}
          </div>
          {%- if s.map_link != blank -%}</a>{%- endif -%}
        {%- else -%}
          <div class="wellness-contact__map wellness-contact__map--placeholder">
            {{ 'image' | placeholder_svg_tag: 'wellness-contact__placeholder' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- FORM ---------- {%- endcomment -%}
      {%- if show_form -%}
        <div class="wellness-contact__form-wrap">
          {%- if form_heading != blank -%}
            <p class="wellness-contact__form-heading">{{ form_heading }}</p>
          {%- endif -%}

          {%- form 'contact', id: contact_form_id, class: 'wellness-contact__form' -%}
            {%- if form.posted_successfully? -%}
              <div
                class="wellness-contact__alert wellness-contact__alert--success"
                role="status"
                tabindex="-1"
                autofocus
              >
                {{ success_msg }}
              </div>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="wellness-contact__alert wellness-contact__alert--error" role="alert" tabindex="-1" autofocus>
                <p>{{ 'templates.contact.form.error_heading' | t | default: 'Please review the form for errors:' }}</p>
                <ul>
                  {%- for field in form.errors -%}
                    <li>
                      {%- if field == 'form' -%}
                        {{ form.errors.messages[field] }}
                      {%- else -%}
                        <a href="#WellnessContactForm-{{ section.id }}-{{ field }}">
                          {{ form.errors.translated_fields[field] | capitalize }}
                          {{ form.errors.messages[field] }}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <input type="hidden" name="contact[name]" data-combined-name>

            <div class="wellness-contact__row wellness-contact__row--2">
              <div class="wellness-contact__field">
                <label for="WellnessContactForm-{{ section.id }}-first">
                  {{ s.first_name_label | default: 'First Name' }}
                  {%- if s.first_name_required %}
                    <span aria-hidden="true">*</span>
                  {%- endif -%}
                </label>
                <input
                  type="text"
                  id="WellnessContactForm-{{ section.id }}-first"
                  name="contact[First name]"
                  autocomplete="given-name"
                  placeholder="{{ s.first_name_placeholder | default: 'Enter First Name' | escape }}"
                  data-first-name
                  {% if s.first_name_required %}
                    required
                  {% endif %}
                >
              </div>
              <div class="wellness-contact__field">
                <label for="WellnessContactForm-{{ section.id }}-last">
                  {{ s.last_name_label | default: 'Last Name' }}
                  {%- if s.last_name_required %}
                    <span aria-hidden="true">*</span>
                  {%- endif -%}
                </label>
                <input
                  type="text"
                  id="WellnessContactForm-{{ section.id }}-last"
                  name="contact[Last name]"
                  autocomplete="family-name"
                  placeholder="{{ s.last_name_placeholder | default: 'Enter Last Name' | escape }}"
                  data-last-name
                  {% if s.last_name_required %}
                    required
                  {% endif %}
                >
              </div>
            </div>

            <div class="wellness-contact__row wellness-contact__row--2">
              <div class="wellness-contact__field">
                <label for="WellnessContactForm-{{ section.id }}-phone">
                  {{ s.phone_label | default: 'Phone Number (Mobile)' }}
                  {%- if s.phone_required %}
                    <span aria-hidden="true">*</span>
                  {%- endif -%}
                </label>
                <input
                  type="tel"
                  id="WellnessContactForm-{{ section.id }}-phone"
                  name="contact[phone]"
                  autocomplete="tel"
                  placeholder="{{ s.phone_placeholder | default: 'Enter Phone Number (Mobile)' | escape }}"
                  {% if s.phone_required %}
                    required
                  {% endif %}
                >
              </div>
              <div class="wellness-contact__field">
                <label for="WellnessContactForm-{{ section.id }}-email">
                  {{ s.email_label | default: 'Email Address' }}
                  <span aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="WellnessContactForm-{{ section.id }}-email"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ s.email_placeholder | default: 'Enter Email Address' | escape }}"
                  required
                  {% if form.email %}
                    value="{{ form.email }}"
                  {% endif %}
                >
              </div>
            </div>

            {%- if s.program_options != blank -%}
              <div class="wellness-contact__field wellness-contact__field--select">
                <label for="WellnessContactForm-{{ section.id }}-program">
                  {{ program_label }}
                  {%- if s.program_required %}
                    <span aria-hidden="true">*</span>
                  {%- endif -%}
                </label>
                <div class="wellness-contact__select-wrap">
                  <select
                    id="WellnessContactForm-{{ section.id }}-program"
                    name="contact[Program of interest]"
                    {% if s.program_required %}
                      required
                    {% endif %}
                  >
                    <option value="" disabled selected>{{ program_ph }}</option>
                    {%- for opt in program_options -%}
                      {%- assign opt_clean = opt | strip -%}
                      {%- if opt_clean != blank -%}
                        <option value="{{ opt_clean | escape }}">{{ opt_clean }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                  <svg
                    class="wellness-contact__select-caret"
                    viewBox="0 0 16 9"
                    width="16"
                    height="9"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M1 1l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            {%- endif -%}

            {%- if s.consent_1_text != blank or s.consent_2_text != blank -%}
              <div class="wellness-contact__consents">
                {%- if s.consent_1_text != blank -%}
                  <label class="wellness-contact__consent">
                    <input
                      type="checkbox"
                      name="contact[Consent — informational]"
                      value="Yes"
                      {% if s.consent_1_required %}
                        required
                      {% endif %}
                    >
                    <span class="wellness-contact__consent-box" aria-hidden="true">
                      <svg viewBox="0 0 12 10" width="12" height="10" focusable="false">
                        <path d="M1 5l3.5 3.5L11 1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="wellness-contact__consent-text rte">{{ s.consent_1_text }}</span>
                  </label>
                {%- endif -%}
                {%- if s.consent_2_text != blank -%}
                  <label class="wellness-contact__consent">
                    <input
                      type="checkbox"
                      name="contact[Consent — marketing]"
                      value="Yes"
                      {% if s.consent_2_required %}
                        required
                      {% endif %}
                    >
                    <span class="wellness-contact__consent-box" aria-hidden="true">
                      <svg viewBox="0 0 12 10" width="12" height="10" focusable="false">
                        <path d="M1 5l3.5 3.5L11 1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="wellness-contact__consent-text rte">{{ s.consent_2_text }}</span>
                  </label>
                {%- endif -%}
              </div>
            {%- endif -%}

            <input type="hidden" name="contact[body]" value="Contact form submitted from Wellness Contact section">

            <button type="submit" class="wellness-contact__submit">
              <span>{{ submit_label }}</span>
            </button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var forms = document.querySelectorAll('#shopify-section-{{ section.id }} .wellness-contact__form');
    forms.forEach(function (form) {
      var first = form.querySelector('[data-first-name]');
      var last = form.querySelector('[data-last-name]');
      var combined = form.querySelector('[data-combined-name]');
      function sync() {
        if (!combined) return;
        var f = first ? first.value.trim() : '';
        var l = last ? last.value.trim() : '';
        combined.value = (f + ' ' + l).trim();
      }
      if (first) first.addEventListener('input', sync);
      if (last) last.addEventListener('input', sync);
      form.addEventListener('submit', sync);
    });
  })();
</script>

{% stylesheet %}
  .wellness-contact {
    background: var(--wc-bg);
    padding-block: var(--wc-pt) var(--wc-pb);
    color: var(--wc-body);
  }
  .wellness-contact *,
  .wellness-contact *::before,
  .wellness-contact *::after {
    box-sizing: border-box;
  }

  .wellness-contact__container {
    max-width: var(--wc-max-w);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 60px);
    width: 100%;
  }

  /* ---------- BANNER ---------- */
  .wellness-contact__banner {
    background: linear-gradient(to bottom, var(--wc-banner-from) 0%, rgba(255, 255, 255, 0) 100%);
    padding-block: var(--wc-banner-pt) var(--wc-banner-pb);
  }
  .wellness-contact__banner-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }
  .wellness-contact__eyebrow {
    margin: 0;
    color: var(--wc-eyebrow);
    font-size: 14px;
    line-height: 22px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .wellness-contact__heading {
    margin: 0;
    color: var(--wc-heading);
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0;
  }
  .wellness-contact__description {
    margin: 4px auto 0;
    max-width: 820px;
    color: var(--wc-body);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.55;
    font-weight: 600;
  }
  .wellness-contact__description :where(p) {
    margin: 0;
  }

  /* ---------- BODY ---------- */
  .wellness-contact__body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-top: 16px;
  }

  /* ---------- INFO CARDS ---------- */
  .wellness-contact__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }
  .wellness-contact__card {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--wc-card-bg);
    border: 1px solid var(--wc-card-border);
    border-radius: var(--wc-card-radius);
    padding: 10px 20px;
    min-height: 103px;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .wellness-contact__card:hover {
    box-shadow: 0 6px 24px rgba(47, 111, 115, 0.08);
    transform: translateY(-1px);
  }
  .wellness-contact__card-icon {
    flex: 0 0 auto;
    width: 24px;
    height: 27px;
    color: var(--wc-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .wellness-contact__card-icon img,
  .wellness-contact__card-icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .wellness-contact__card-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .wellness-contact__card-title {
    margin: 0;
    color: var(--wc-card-label);
    font-weight: 600;
    font-size: 16px;
    line-height: 26px;
  }
  .wellness-contact__card-lines {
    margin: 0;
    color: var(--wc-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 26px;
  }

  /* ---------- SPLIT ---------- */
  .wellness-contact__split {
    display: grid;
    grid-template-columns: minmax(0, 510fr) minmax(0, 650fr);
    gap: 40px;
    align-items: stretch;
  }
  .wellness-contact__media {
    display: flex;
  }
  .wellness-contact__map {
    position: relative;
    width: 100%;
    min-height: 320px;
    border: 1px solid var(--wc-card-border);
    border-radius: var(--wc-radius);
    overflow: hidden;
    background: #eef2f3;
  }
  .wellness-contact__map iframe,
  .wellness-contact__map img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    display: block;
  }
  .wellness-contact__map--placeholder svg {
    width: 100%;
    height: 100%;
  }
  .wellness-contact__map-link {
    display: block;
    width: 100%;
  }

  /* ---------- FORM ---------- */
  .wellness-contact__form-wrap {
    background: var(--wc-form-bg);
    border: 1px solid var(--wc-form-border);
    border-radius: var(--wc-radius);
    padding: clamp(20px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .wellness-contact__form-heading {
    margin: 0;
    color: var(--wc-body);
    font-size: 20px;
    line-height: 32px;
    font-weight: 600;
  }
  .wellness-contact__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
  }
  .wellness-contact__row {
    display: grid;
    gap: 16px;
  }
  .wellness-contact__row--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .wellness-contact__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .wellness-contact__field label {
    color: var(--wc-card-label);
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
  }
  .wellness-contact__field input,
  .wellness-contact__field select,
  .wellness-contact__field textarea {
    appearance: none;
    -webkit-appearance: none;
    background: var(--wc-input-bg);
    border: 1px solid var(--wc-form-border);
    border-radius: 8px;
    height: 54px;
    padding: 0 20px;
    font-size: 14px;
    line-height: 22px;
    color: var(--wc-body);
    font-family: inherit;
    width: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .wellness-contact__field input::placeholder,
  .wellness-contact__field textarea::placeholder {
    color: var(--wc-input-placeholder);
  }
  .wellness-contact__field input:focus,
  .wellness-contact__field select:focus,
  .wellness-contact__field textarea:focus {
    outline: none;
    border-color: var(--wc-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--wc-accent) 18%, transparent);
  }
  .wellness-contact__select-wrap {
    position: relative;
  }
  .wellness-contact__select-wrap select {
    padding-right: 48px;
    cursor: pointer;
    color: var(--wc-body);
  }
  .wellness-contact__select-wrap select:invalid {
    color: var(--wc-input-placeholder);
  }
  .wellness-contact__select-caret {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--wc-card-label);
  }

  /* ---------- CONSENT ---------- */
  .wellness-contact__consents {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .wellness-contact__consent {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: start;
    cursor: pointer;
    line-height: 19px;
  }
  .wellness-contact__consent input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .wellness-contact__consent-box {
    width: 18px;
    height: 18px;
    background: #fff;
    border: 1.5px solid var(--wc-accent);
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--wc-accent);
    transition: background 0.15s ease;
  }
  .wellness-contact__consent-box svg {
    opacity: 0;
    transition: opacity 0.15s ease;
    color: var(--wc-accent-contrast);
  }
  .wellness-contact__consent input:checked + .wellness-contact__consent-box {
    background: var(--wc-accent);
  }
  .wellness-contact__consent input:checked + .wellness-contact__consent-box svg {
    opacity: 1;
  }
  .wellness-contact__consent input:focus-visible + .wellness-contact__consent-box {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--wc-accent) 25%, transparent);
  }
  .wellness-contact__consent-text {
    color: var(--wc-card-label);
    font-size: 12px;
    line-height: 19px;
  }
  .wellness-contact__consent-text :where(a) {
    color: var(--wc-accent);
    text-decoration: underline;
  }
  .wellness-contact__consent-text :where(p) {
    margin: 0;
  }

  /* ---------- SUBMIT ---------- */
  .wellness-contact__submit {
    appearance: none;
    border: 0;
    margin-top: 4px;
    width: 100%;
    background: var(--wc-accent);
    color: var(--wc-accent-contrast);
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 16px;
    line-height: 26px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: filter 0.15s ease, transform 0.05s ease;
  }
  .wellness-contact__submit:hover {
    filter: brightness(0.95);
  }
  .wellness-contact__submit:active {
    transform: translateY(1px);
  }
  .wellness-contact__submit:focus-visible {
    outline: 2px solid var(--wc-accent);
    outline-offset: 3px;
  }

  /* ---------- ALERTS ---------- */
  .wellness-contact__alert {
    border-radius: 8px;
    padding: 14px 16px;
    font-size: 14px;
    line-height: 20px;
  }
  .wellness-contact__alert--success {
    background: #e8f4f4;
    color: #1f4f52;
    border: 1px solid #b9dbdd;
  }
  .wellness-contact__alert--error {
    background: #fdecec;
    color: #8a1b1b;
    border: 1px solid #f3c2c2;
  }
  .wellness-contact__alert ul {
    margin: 6px 0 0;
    padding-left: 18px;
  }
  .wellness-contact__alert a {
    color: inherit;
    text-decoration: underline;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 1199px) {
    .wellness-contact__split {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 989px) {
    .wellness-contact__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wellness-contact__split {
      grid-template-columns: 1fr;
    }
    .wellness-contact__map {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
  @media (max-width: 749px) {
    .wellness-contact__banner {
      padding-block: 56px 24px;
    }
    .wellness-contact__body {
      gap: 28px;
    }
    .wellness-contact__cards {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .wellness-contact__card {
      min-height: 0;
      padding: 14px 16px;
    }
    .wellness-contact__row--2 {
      grid-template-columns: 1fr;
    }
    .wellness-contact__form-wrap {
      border-radius: 16px;
    }
    .wellness-contact__map {
      border-radius: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wellness-contact__card,
    .wellness-contact__submit,
    .wellness-contact__field input,
    .wellness-contact__field select,
    .wellness-contact__consent-box,
    .wellness-contact__consent-box svg {
      transition: none;
    }
  }
{% endstylesheet %}


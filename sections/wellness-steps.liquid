{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wc-heading wc-heading--lg">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="wc-text wc-text--lead">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="wc-steps">
      {%- for block in section.blocks -%}
        <div class="wc-steps__item" {{ block.shopify_attributes }}>
          <span class="wc-steps__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'consult' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8h20v14H14l-6 5v-5H6z"/><path d="M12 13h8M12 17h6"/></svg>
              {%- when 'plan' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="6" width="20" height="22" rx="2"/><path d="M10 12h12M10 16h12M10 20h8"/></svg>
              {%- when 'support' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="16" cy="11" r="4"/><path d="M8 27v-2c0-4 4-6 8-6s8 2 8 6v2"/></svg>
              {%- when 'lab' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 4v8L7 24a3 3 0 003 4h12a3 3 0 003-4l-6-12V4"/></svg>
              {%- when 'check' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 16l6 6 12-12" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'calendar' -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="8" width="20" height="18" rx="2"/><path d="M6 14h20M11 5v6M21 5v6"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="16" cy="16" r="10"/></svg>
            {%- endcase -%}
            {%- if block.settings.show_number -%}
              <span class="wc-steps__number">{{ forloop.index }}</span>
            {%- endif -%}
          </span>
          <h3 class="wc-steps__title">
            {%- if block.settings.show_number -%}{{ forloop.index }}. {% endif -%}
            {{ block.settings.title | escape }}
          </h3>
          <p class="wc-steps__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="wc-steps__cta">
        <a href="{{ section.settings.button_link | default: '#' }}" class="wc-btn wc-btn--primary">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .wc-steps {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Wellness steps",
  "tag": "section",
  "class": "shopify-section--wellness-steps",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Step-by-Step Medical Weight Loss Plan" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>A clear, physician-guided process designed to move you from evaluation to lasting results.</p>" },
    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "mint",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Optional CTA" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Your Medical Weight Loss Plan" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "consult",
          "options": [
            { "value": "consult", "label": "Consultation" },
            { "value": "plan", "label": "Plan" },
            { "value": "support", "label": "Ongoing support" },
            { "value": "lab", "label": "Lab" },
            { "value": "check", "label": "Check" },
            { "value": "calendar", "label": "Calendar" }
          ]
        },
        { "type": "checkbox", "id": "show_number", "label": "Show step number", "default": true },
        { "type": "text", "id": "title", "label": "Title", "default": "Consultation & Medical Evaluation" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "We review your medical history and goals, plus baseline labs to understand your starting point and develop the safest treatment approach." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness steps",
      "blocks": [
        { "type": "step", "settings": { "icon": "consult", "title": "Consultation & Medical Evaluation", "text": "We review your medical history, goals, and run baseline labs to understand your starting point." } },
        { "type": "step", "settings": { "icon": "plan", "title": "Personalized Treatment Plan", "text": "Your physician designs a plan using evidence-based medications, lab targets, and clinical goals." } },
        { "type": "step", "settings": { "icon": "support", "title": "Ongoing Care & Adjustments", "text": "Regular check-ins, lab reviews, and plan adjustments to keep you on track safely." } }
      ]
    }
  ]
}
{% endschema %}

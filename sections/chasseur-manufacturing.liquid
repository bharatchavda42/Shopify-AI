{{ 'section-chasseur-manufacturing.css' | asset_url | stylesheet_tag }}

<section
  class="chasseur-manufacturing"
  style="
    --left-grad-start: {{ section.settings.left_gradient_start }};
    --right-bg: {{ section.settings.right_background }};
    --eyebrow-color: {{ section.settings.eyebrow_color }};
    --heading-color: {{ section.settings.heading_color }};
    --body-color: {{ section.settings.body_color }};
    --section-height: {{ section.settings.section_height }}px;
    --section-height-mobile: {{ section.settings.section_height_mobile }}px;
    --image-position: {{ section.settings.image_position | default: 'left' }};
  "
>
  <div class="chasseur-manufacturing__left{% if section.settings.image_position == 'right' %} chasseur-manufacturing__left--reverse{% endif %}">
    {%- if section.settings.logo_image != blank -%}
      <div class="chasseur-manufacturing__logo">
        {{
          section.settings.logo_image
          | image_url: width: 340
          | image_tag:
            loading: 'lazy',
            class: 'chasseur-manufacturing__logo-img',
            widths: '170, 340',
            sizes: '170px',
            alt: section.settings.logo_image.alt | escape
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.product_image != blank -%}
      <div class="chasseur-manufacturing__product-img-wrap">
        {{
          section.settings.product_image
          | image_url: width: 2100
          | image_tag:
            loading: 'lazy',
            class: 'chasseur-manufacturing__product-img',
            widths: '750, 1050, 1440, 2100',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.product_image.alt | escape
        }}
      </div>
    {%- endif -%}
  </div>

  <div class="chasseur-manufacturing__right">
    <div class="chasseur-manufacturing__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="chasseur-manufacturing__eyebrow-row">
          <span class="chasseur-manufacturing__eyebrow-line" aria-hidden="true"></span>
          <span class="chasseur-manufacturing__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="chasseur-manufacturing__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="chasseur-manufacturing__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url | default: '#' }}" class="chasseur-manufacturing__btn">
          {{ section.settings.button_label | escape }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manufacturing Split",
  "tag": "section",
  "class": "shopify-section--chasseur-manufacturing",
  "settings": [
    { "type": "header", "content": "Left panel — image" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image (shown top-centre)" },
    { "type": "image_picker", "id": "product_image", "label": "Product / hero image" },
    { "type": "color", "id": "left_gradient_start", "label": "Left panel gradient start colour", "default": "#DED6CC" },
    { "type": "header", "content": "Right panel — text" },
    { "type": "color", "id": "right_background", "label": "Right panel background", "default": "#353131" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Our History" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow colour", "default": "#FFFFFF" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Manufacturing Chasseur" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#FFFFFF" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Chasseur's history is rooted in the very heart of the Ardennes, during the belle époque. Or, more precisely, in 1924 when the Invicta foundry was established in the Meuse Valley, a major centre for metallurgy. Founded by Fernand Sueur, the company would go on to remain a family business for nearly 90 years. The production sites have been located in Donchery and Vivier-au-court since the very beginning.</p>" },
    { "type": "color", "id": "body_color", "label": "Body text colour", "default": "#E3E3E3" },
    { "type": "header", "content": "CTA button" },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave blank to hide" },
    { "type": "url", "id": "button_url", "label": "Button URL" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_position", "label": "Image side", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 20, "unit": "px", "label": "Section height (desktop)", "default": 520 },
    { "type": "range", "id": "section_height_mobile", "min": 200, "max": 600, "step": 20, "unit": "px", "label": "Section height (mobile)", "default": 400 }
  ],
  "presets": [
    {
      "name": "Manufacturing Split",
      "settings": {
        "left_gradient_start": "#DED6CC",
        "right_background": "#353131",
        "eyebrow": "Our History",
        "eyebrow_color": "#FFFFFF",
        "heading": "Manufacturing Chasseur",
        "heading_color": "#FFFFFF",
        "body": "<p>Chasseur's history is rooted in the very heart of the Ardennes, during the belle époque. Or, more precisely, in 1924 when the Invicta foundry was established in the Meuse Valley, a major centre for metallurgy. Founded by Fernand Sueur, the company would go on to remain a family business for nearly 90 years. The production sites have been located in Donchery and Vivier-au-court since the very beginning.</p>",
        "body_color": "#E3E3E3",
        "image_position": "left",
        "section_height": 520,
        "section_height_mobile": 400
      }
    }
  ]
}
{% endschema %}

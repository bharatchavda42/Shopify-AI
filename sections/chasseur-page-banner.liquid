{{ 'section-chasseur-page-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  class="chasseur-page-banner"
  style="
    --banner-height: {{ section.settings.banner_height }}px;
    --banner-height-mobile: {{ section.settings.banner_height_mobile }}px;
    --overlay-opacity: {{ overlay_opacity }};
    --overlay-color: {{ section.settings.overlay_color }};
    --heading-color: {{ section.settings.heading_color }};
    --breadcrumb-color: {{ section.settings.breadcrumb_color }};
    --separator-color: {{ section.settings.separator_color }};
  "
>
  <div class="chasseur-page-banner__bg">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag:
          loading: 'eager',
          class: 'chasseur-page-banner__bg-img',
          widths: '750, 1024, 1440, 1920',
          sizes: '100vw',
          alt: section.settings.background_image.alt | escape
      }}
    {%- endif -%}
    <div class="chasseur-page-banner__overlay"></div>
  </div>

  <div class="chasseur-page-banner__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="chasseur-page-banner__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.show_breadcrumbs -%}
      <nav class="chasseur-page-banner__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}" class="chasseur-page-banner__crumb-link">
          {{- section.settings.breadcrumb_home | default: 'Home' | escape -}}
        </a>
        <span class="chasseur-page-banner__crumb-sep" aria-hidden="true">/</span>
        <span class="chasseur-page-banner__crumb-current">
          {{- section.settings.heading | escape -}}
        </span>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page Banner",
  "tag": "section",
  "class": "shopify-section--chasseur-page-banner",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Page title", "default": "Cast Iron Day-to-Day" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "breadcrumb_home", "label": "Home label", "default": "Home" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 50 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#FFFFFF" },
    { "type": "color", "id": "breadcrumb_color", "label": "Breadcrumb link colour", "default": "#FFFFFF" },
    { "type": "color", "id": "separator_color", "label": "Separator & current page colour", "default": "#E0DAD7" },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "banner_height", "min": 200, "max": 600, "step": 20, "unit": "px", "label": "Height (desktop)", "default": 300 },
    { "type": "range", "id": "banner_height_mobile", "min": 120, "max": 400, "step": 20, "unit": "px", "label": "Height (mobile)", "default": 200 }
  ],
  "presets": [
    {
      "name": "Page Banner",
      "settings": {
        "heading": "Cast Iron Day-to-Day",
        "show_breadcrumbs": true,
        "breadcrumb_home": "Home",
        "overlay_color": "#000000",
        "overlay_opacity": 50,
        "heading_color": "#FFFFFF",
        "breadcrumb_color": "#FFFFFF",
        "separator_color": "#E0DAD7",
        "banner_height": 300,
        "banner_height_mobile": 200
      }
    }
  ]
}
{% endschema %}

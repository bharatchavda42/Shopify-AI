{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-cta" style="background: {{ section.settings.bg_color }};">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="wc-eyebrow" style="color: rgba(255,255,255,.8);">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wc-cta__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="wc-cta__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <div class="wc-cta__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="wc-btn wc-btn--primary">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" class="wc-btn wc-btn--outline" style="color:#fff; border-color: rgba(255,255,255,.4);">
            {{ section.settings.phone | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness CTA",
  "tag": "section",
  "class": "shopify-section--wellness-cta",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book Your Physician-Supervised Weight Loss Plan Today" },
    { "type": "richtext", "id": "text", "label": "Body", "default": "<p>Schedule your initial consultation in office or virtually. Our team will get back to you within 24 hours.</p>" },
    { "type": "header", "content": "Primary action" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book Consultation" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "phone", "label": "Phone (secondary action)", "default": "(984) 304-2060" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#0F2A29" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 }
  ],
  "presets": [
    { "name": "Wellness CTA" }
  ]
}
{% endschema %}

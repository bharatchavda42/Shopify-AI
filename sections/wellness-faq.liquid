{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wc-heading wc-heading--lg">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="wc-text wc-text--lead">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <div class="wc-faq" itemscope itemtype="https://schema.org/FAQPage">
      {%- for block in section.blocks -%}
        <details class="wc-faq__item" {{ block.shopify_attributes }} {% if forloop.first and section.settings.first_open %}open{% endif %} itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="wc-faq__summary">
            <span itemprop="name">{{ block.settings.question | escape }}</span>
            <span class="wc-faq__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
            </span>
          </summary>
          <div class="wc-faq__body" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">{{ block.settings.answer }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness FAQ",
  "tag": "section",
  "class": "shopify-section--wellness-faq",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "first_open", "label": "Open the first item by default", "default": true },
    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "alt",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is this program covered by insurance?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Coverage depends on your plan. Lab work and in-office visits may be covered, while compounded medications are typically self-pay. We can help with prior authorization when appropriate.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Is this program covered by insurance?", "answer": "<p>Coverage depends on your plan. Lab work and in-office visits may be covered, while compounded medications are typically self-pay. We can help with prior authorization when appropriate.</p>" } },
        { "type": "faq", "settings": { "question": "Are the medications safe?", "answer": "<p>All medications are physician-prescribed and monitored through routine labs and follow-ups to confirm they remain safe and effective for you.</p>" } },
        { "type": "faq", "settings": { "question": "How long until I see results?", "answer": "<p>Most patients see meaningful progress within the first 8–12 weeks. Long-term results are driven by adherence and ongoing physician care.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer virtual appointments?", "answer": "<p>Yes. We offer both in-office and virtual visits for North Carolina patients.</p>" } }
      ]
    }
  ]
}
{% endschema %}

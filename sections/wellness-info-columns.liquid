{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-info">
      {%- for block in section.blocks -%}
        <div class="wc-info__col" {{ block.shopify_attributes }}>
          {%- if block.settings.eyebrow != blank -%}
            <span class="wc-eyebrow">{{ block.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="wc-heading wc-heading--md">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.intro != blank -%}
            <div class="wc-text">{{ block.settings.intro }}</div>
          {%- endif -%}
          {%- if block.settings.list != blank -%}
            <ul class="wc-list">
              {%- assign items = block.settings.list | newline_to_br | split: '<br />' -%}
              {%- for item in items -%}
                {%- assign trimmed = item | strip -%}
                {%- if trimmed != '' -%}
                  <li>{{ trimmed | strip_html }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.outro != blank -%}
            <div class="wc-text" style="margin-top:16px;">{{ block.settings.outro }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness info columns",
  "tag": "section",
  "class": "shopify-section--wellness-info-columns",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Who This Program Is For" },
        { "type": "richtext", "id": "intro", "label": "Intro paragraph", "default": "<p>This program is designed for patients who need a structured, physician-supervised approach to weight management.</p>" },
        { "type": "textarea", "id": "list", "label": "Bulleted list (one item per line)", "default": "Have a BMI of 27 or higher with weight-related health concerns\nHave had difficulty losing weight with diet and exercise alone\nAre interested in FDA-approved medications such as semaglutide or tirzepatide\nPrefer a medically guided, long-term approach to weight loss" },
        { "type": "richtext", "id": "outro", "label": "Closing paragraph" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness info columns",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Who This Program Is For",
            "intro": "<p>This program is designed for patients who need a structured, physician-supervised approach to weight management.</p><p>It may be appropriate if you:</p>",
            "list": "Have a BMI of 27 or higher with weight-related health concerns\nHave had difficulty losing weight with diet and exercise alone\nAre interested in FDA-approved medications such as semaglutide or tirzepatide\nPrefer a medically guided, long-term approach to weight loss"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "What You Get",
            "intro": "<p>This program is structured around physician-led, evidence-based care focused on real outcomes.</p><p>During care, you'll receive:</p>",
            "list": "Regular physician check-ins\nLab monitoring and reviews\nMedication oversight when appropriate\nGuidance on nutrition and activity\nA plan tailored to your medical history\nOngoing adjustments as needed"
          }
        }
      ]
    }
  ]
}
{% endschema %}

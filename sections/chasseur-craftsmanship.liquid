{{ 'section-chasseur-craftsmanship.css' | asset_url | stylesheet_tag }}

<section
  class="chasseur-craftsmanship"
  style="
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
    --section-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-bg: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --card-bg: {{ section.settings.card_background }};
    --card-border: {{ section.settings.card_border_color }};
    --icon-bg: {{ section.settings.icon_bg_color }};
    --label-color: {{ section.settings.label_color }};
    --card-title-color: {{ section.settings.card_title_color }};
    --card-body-color: {{ section.settings.card_body_color }};
    --footnote-color: {{ section.settings.footnote_color }};
  "
>
  <div class="chasseur-craftsmanship__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="chasseur-craftsmanship__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="chasseur-craftsmanship__cards">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'card' -%}
              <div class="chasseur-craftsmanship__card" {{ block.shopify_attributes }}>
                <div class="chasseur-craftsmanship__icon-circle">
                  {%- if block.settings.icon_image != blank -%}
                    {{
                      block.settings.icon_image
                      | image_url: width: 68
                      | image_tag:
                        loading: 'lazy',
                        class: 'chasseur-craftsmanship__icon-img',
                        widths: '34, 68',
                        sizes: '34px',
                        alt: block.settings.label | escape
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'chasseur-craftsmanship__icon-img chasseur-craftsmanship__icon-img--placeholder' }}
                  {%- endif -%}
                </div>

                {%- if block.settings.label != blank -%}
                  <p class="chasseur-craftsmanship__label">{{ block.settings.label | escape }}</p>
                {%- endif -%}

                {%- if block.settings.card_heading != blank -%}
                  <h3 class="chasseur-craftsmanship__card-heading">{{ block.settings.card_heading | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.body != blank -%}
                  <div class="chasseur-craftsmanship__body">{{ block.settings.body }}</div>
                {%- endif -%}

                {%- if block.settings.footnote != blank -%}
                  <p class="chasseur-craftsmanship__footnote">{{ block.settings.footnote | escape }}</p>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Craftsmanship Cards",
  "tag": "section",
  "class": "shopify-section--chasseur-craftsmanship",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Craftsmanship You Can Trust" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#1B1918" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F2EFEB" },
    { "type": "color", "id": "card_border_color", "label": "Card border colour", "default": "#D6D6D6" },
    { "type": "color", "id": "icon_bg_color", "label": "Icon circle background", "default": "#857B7A" },
    { "type": "color", "id": "label_color", "label": "Label colour", "default": "#44362B" },
    { "type": "color", "id": "card_title_color", "label": "Card title colour", "default": "#3C2D25" },
    { "type": "color", "id": "card_body_color", "label": "Card body colour", "default": "#44362B" },
    { "type": "color", "id": "footnote_color", "label": "Footnote colour", "default": "#000000" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top (desktop)", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom (desktop)", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding top (mobile)", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding bottom (mobile)", "default": 40 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image" },
        { "type": "text", "id": "label", "label": "Label (eyebrow)", "default": "Label" },
        { "type": "text", "id": "card_heading", "label": "Card heading", "default": "Card Heading" },
        { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Describe this benefit in a concise, compelling way.</p>" },
        { "type": "text", "id": "footnote", "label": "Footnote (italic)", "info": "Shown in italic below the body text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship Cards",
      "settings": {
        "heading": "Craftsmanship You Can Trust",
        "background_color": "#FFFFFF",
        "heading_color": "#1B1918",
        "card_background": "#F2EFEB",
        "card_border_color": "#D6D6D6",
        "icon_bg_color": "#857B7A",
        "label_color": "#44362B",
        "card_title_color": "#3C2D25",
        "card_body_color": "#44362B",
        "footnote_color": "#000000",
        "padding_top": 80,
        "padding_bottom": 80,
        "padding_top_mobile": 40,
        "padding_bottom_mobile": 40
      },
      "blocks": [
        {
          "type": "card",
          "settings": {
            "label": "SUSTAINABLE BY DESIGN",
            "card_heading": "Environmentally friendly",
            "body": "<p>Enamelled cast iron is durable and 100% recyclable. Chasseur uses locally sourced raw materials — and the enamelled iron at the core of every piece comes from France.</p>",
            "footnote": "Manufactured to the highest environmental standards in our French foundry."
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "LIFETIME ASSURANCE",
            "card_heading": "Cookware with a lifetime guarantee",
            "body": "<p>Chasseur is proud of the manufacturing quality of its products. Our cookware is built to last a lifetime — and we stand fully behind that promise.</p>",
            "footnote": "A lifetime guarantee is offered if the instructions for use and maintenance described in the manual are followed."
          }
        }
      ]
    }
  ]
}
{% endschema %}

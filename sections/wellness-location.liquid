{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-location">
      <div class="wc-location__info">
        {%- if section.settings.eyebrow != blank -%}
          <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wc-heading wc-heading--md">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="wc-text">{{ section.settings.intro }}</div>
        {%- endif -%}

        <dl class="wc-location__meta">
          {%- if section.settings.address != blank -%}
            <div><strong>Address</strong><br>{{ section.settings.address | newline_to_br }}</div>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <div><strong>Phone</strong><br><a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" style="color:var(--wc-primary); text-decoration:none;">{{ section.settings.phone | escape }}</a></div>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <div><strong>Hours</strong><br>{{ section.settings.hours | newline_to_br }}</div>
          {%- endif -%}
        </dl>

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:18px;">
            <a href="{{ section.settings.button_link | default: '#' }}" class="wc-btn wc-btn--primary">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>

      <div class="wc-location__map">
        {%- if section.settings.map_embed_url != blank -%}
          <iframe
            src="{{ section.settings.map_embed_url }}"
            loading="lazy"
            title="{{ section.settings.heading | default: 'Clinic location' | escape }} map"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        {%- elsif section.settings.map_image != blank -%}
          <img
            src="{{ section.settings.map_image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | default: 'Clinic location' | escape }}"
            loading="lazy"
            decoding="async"
            width="{{ section.settings.map_image.width }}"
            height="{{ section.settings.map_image.height }}"
            style="width:100%; height:100%; object-fit:cover;"
          >
        {%- else -%}
          <div class="wc-location__map-placeholder">
            <svg viewBox="0 0 32 32" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M16 28s10-9 10-16a10 10 0 10-20 0c0 7 10 16 10 16z"/>
              <circle cx="16" cy="12" r="4"/>
            </svg>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness location",
  "tag": "section",
  "class": "shopify-section--wellness-location",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Medical Weight Loss Clinic in Charlotte, NC" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Conveniently located in Charlotte, NC, serving patients in Charlotte, Matthews, Harrisburg, Concord, and surrounding areas, with both in-person and virtual care options.</p>" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "1234 Wellness Blvd Suite 100\nCharlotte, NC 28202" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(984) 304-2060" },
    { "type": "textarea", "id": "hours", "label": "Hours", "default": "Mon–Fri: 8am – 6pm\nSat: 9am – 1pm" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book Your Consultation" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Map" },
    { "type": "url", "id": "map_embed_url", "label": "Google Maps embed URL", "info": "Paste the src URL from a Google Maps embed." },
    { "type": "image_picker", "id": "map_image", "label": "Or use a static map image" },
    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "alt",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [
    { "name": "Wellness location" }
  ]
}
{% endschema %}

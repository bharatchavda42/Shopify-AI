{{ 'wellness.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wellness.js' | asset_url }}" defer="defer"></script>

<header class="wc-header" role="banner" style="
  --wc-primary: {{ section.settings.brand_primary }};
  --wc-primary-dark: {{ section.settings.brand_primary | color_darken: 10 }};
  --wc-text: {{ section.settings.text_color }};
">
  <div class="wc-page-width">
    <div class="wc-header__inner">
      <a href="{{ routes.root_url }}" class="wc-header__logo" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 240 }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            loading="eager"
            decoding="async"
            class="wc-header__logo-img"
            style="max-width: {{ section.settings.logo_width }}px; height:auto;"
          >
        {%- else -%}
          <svg class="wc-header__logo-img" width="48" height="48" viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="22" fill="{{ section.settings.brand_primary }}" opacity=".12"/>
            <path d="M16 14 Q20 10 28 14 Q24 22 22 30 Q18 28 16 14Z" fill="{{ section.settings.brand_primary }}"/>
            <path d="M30 16 Q36 18 36 26 Q34 30 30 32 Q30 24 28 16 Z" fill="#B69152"/>
          </svg>
        {%- endif -%}
        {%- if section.settings.show_logo_text -%}
          <span class="wc-header__logo-text">
            <span class="wc-header__logo-title">{{ section.settings.logo_title | escape }}</span>
            <span class="wc-header__logo-sub">{{ section.settings.logo_subtitle | escape }}</span>
          </span>
        {%- endif -%}
      </a>

      <nav class="wc-nav" role="navigation" aria-label="Main navigation">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
            {{- link.title | escape -}}
          </a>
        {%- endfor -%}
      </nav>

      <div style="display:flex; align-items:center; gap:12px;">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link }}" class="wc-btn wc-btn--primary wc-header__cta">
            {{ section.settings.cta_label | escape }}
          </a>
        {%- endif -%}

        <button type="button" class="wc-header__toggle" data-wc-drawer-open aria-controls="wc-drawer" aria-expanded="false" aria-label="Open menu">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="wc-drawer" id="wc-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="wc-drawer__panel">
    <div class="wc-drawer__head">
      <a href="{{ routes.root_url }}" class="wc-header__logo" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name | escape }}"
            loading="lazy"
            decoding="async"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            style="max-width: 56px; height:auto;"
          >
        {%- endif -%}
        {%- if section.settings.show_logo_text -%}
          <span class="wc-header__logo-text">
            <span class="wc-header__logo-title">{{ section.settings.logo_title | escape }}</span>
            <span class="wc-header__logo-sub">{{ section.settings.logo_subtitle | escape }}</span>
          </span>
        {%- endif -%}
      </a>
      <button type="button" class="wc-drawer__close" data-wc-drawer-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav class="wc-drawer__nav" aria-label="Mobile navigation">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
          {{- link.title | escape -}}
        </a>
        {%- if link.links != blank -%}
          {%- for child in link.links -%}
            <a href="{{ child.url }}" style="padding-left:28px; font-size:14px;">
              {{- child.title | escape -}}
            </a>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </nav>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link }}" class="wc-btn wc-btn--primary wc-btn--block wc-drawer__cta">
        {{ section.settings.cta_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Wellness header",
  "tag": "section",
  "class": "shopify-section--wellness-header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 40, "max": 180, "step": 10, "unit": "px", "default": 60 },
    { "type": "checkbox", "id": "show_logo_text", "label": "Show wordmark next to logo", "default": true },
    { "type": "text", "id": "logo_title", "label": "Wordmark title", "default": "CHARLOTTE" },
    { "type": "text", "id": "logo_subtitle", "label": "Wordmark subtitle", "default": "Weight loss & wellness clinic" },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Book Consultation" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#2C6E69" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1F2937" }
  ],
  "presets": [
    { "name": "Wellness header" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}

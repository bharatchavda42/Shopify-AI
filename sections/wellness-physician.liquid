{{ 'wellness.css' | asset_url | stylesheet_tag }}

<section
  class="wc-section {% if section.settings.background == 'alt' %}wc-section--alt{% elsif section.settings.background == 'mint' %}wc-section--mint{% endif %}"
  style="padding-top: {{ section.settings.padding_top_mobile }}px; padding-bottom: {{ section.settings.padding_bottom_mobile }}px;"
>
  <style>
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} > section {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  </style>
  <div class="wc-page-width">
    <div class="wc-iwt {% if section.settings.image_position == 'right' %}wc-iwt--reverse{% endif %}">
      <div class="wc-iwt__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="{{ section.settings.image | image_url: width: 480 }} 480w, {{ section.settings.image | image_url: width: 720 }} 720w, {{ section.settings.image | image_url: width: 960 }} 960w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 45vw, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="wc-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wc-heading wc-heading--lg">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="wc-text">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="wc-list" style="margin-top:18px;">
            {%- for block in section.blocks -%}
              {%- if block.type == 'point' -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.author_name != blank or section.settings.author_role != blank -%}
          <div class="wc-testimonial__meta" style="margin-top:24px;">
            {%- if section.settings.author_image != blank -%}
              <span class="wc-testimonial__avatar" style="background:var(--wc-mint);">
                <img src="{{ section.settings.author_image | image_url: width: 120 }}" alt="{{ section.settings.author_name | escape }}" loading="lazy" decoding="async" width="56" height="56">
              </span>
            {%- endif -%}
            <span>
              {%- if section.settings.author_name != blank -%}
                <span class="wc-testimonial__name" style="color:var(--wc-text);">{{ section.settings.author_name | escape }}</span><br>
              {%- endif -%}
              {%- if section.settings.author_role != blank -%}
                <span class="wc-text wc-text--small" style="color:var(--wc-text-soft);">{{ section.settings.author_role | escape }}</span>
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top:24px;">
            <a href="{{ section.settings.button_link | default: '#' }}" class="wc-btn wc-btn--primary">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wellness image + text",
  "tag": "section",
  "class": "shopify-section--wellness-physician",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Physician Oversight" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>All treatment plans are directed and closely monitored by a board-certified internal medicine physician to ensure safe, consistent progress.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Author" },
    { "type": "image_picker", "id": "author_image", "label": "Author photo" },
    { "type": "text", "id": "author_name", "label": "Author name", "default": "Dr. Joseph Okoye, MD" },
    { "type": "text", "id": "author_role", "label": "Author role", "default": "Board-Certified Internal Medicine" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ]
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom (desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet point",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Evidence-based medications" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wellness image + text",
      "blocks": [
        { "type": "point", "settings": { "text": "Board-certified physician oversight" } },
        { "type": "point", "settings": { "text": "Evidence-based medications (semaglutide, tirzepatide)" } },
        { "type": "point", "settings": { "text": "Routine lab monitoring and individualized care" } }
      ]
    }
  ]
}
{% endschema %}

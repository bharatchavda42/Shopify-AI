    "craftsmanship": {
      "type": "chasseur-craftsmanship",
      "blocks": {
        "cr1": {
          "type": "card",
          "settings": {
            "label": "SUSTAINABLE BY DESIGN",
            "card_heading": "Environmentally friendly",
            "body": "<p>Enamelled cast iron is durable and 100% recyclable. Chasseur uses locally sourced raw materials — and the enamelled iron at the core of every piece comes from France.</p>",
            "footnote": "Manufactured to the highest environmental standards in our French foundry."
          }
        },
        "cr2": {
          "type": "card",
          "settings": {
            "label": "LIFETIME ASSURANCE",
            "card_heading": "Cookware with a lifetime guarantee",
            "body": "<p>Chasseur is proud of the manufacturing quality of its products. Our cookware is built to last a lifetime — and we stand fully behind that promise.</p>",
            "footnote": "A lifetime guarantee is offered if the instructions for use and maintenance described in the manual are followed."
          }
        }
      },
      "block_order": ["cr1", "cr2"],
      "settings": {
        "heading": "Craftsmanship You Can Trust",
